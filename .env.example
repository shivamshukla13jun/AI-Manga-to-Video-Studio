# Copy to .env.development / .env.staging / .env.production.
# src/config/env.ts loads .env.<NODE_ENV> first, then .env as a fallback.

# Node Environment
NODE_ENV=development

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/ecommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this
JWT_EXPIRE=1h

# Frontend
FRONTEND_URL=http://localhost:5173

# Security
BCRYPT_ROUNDS=12

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# RabbitMQ (RABBITMQ_URL wins; otherwise built from host/port/user/pass)
RABBITMQ_URL=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# File upload
UPLOAD_BASE_DIR=uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,application/pdf,text/plain

# Storage provider: local | s3 | cloudinary | firebase
STORAGE_PROVIDER=local

# AWS S3 (required when STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_PUBLIC_URL=


# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uploads

# Firebase Storage (required when STORAGE_PROVIDER=firebase)
FIREBASE_STORAGE_BUCKET=

# Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# Hybrid payload encryption (RSA-OAEP + AES-256-GCM).
# Requests with header `isencrypted: true` are decrypted; responses
# returned as { iv, data }. Keypair auto-generated at the paths below.
ENCRYPTION_ENABLED=true
ENCRYPTION_PRIVATE_KEY_PATH=keys/private.pem
ENCRYPTION_PUBLIC_KEY_PATH=keys/public.pem
ENCRYPTION_MAX_AGE_MS=300000

# Auto-generated Swagger docs at /api-docs
SWAGGER_ENABLED=true
SWAGGER_TITLE=E-commerce API

# Seed default data on server boot
SEED_ON_BOOT=false

# ---------------------------------------------------------------------------
# AI Manga-to-Video Studio
# ---------------------------------------------------------------------------

# Seed credentials (used by SEED_ON_BOOT / data init — change in production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=change-me-superadmin

# Studio media / uploads
MEDIA_URL_SECRET=            # falls back to JWT_SECRET
MEDIA_URL_TTL_SECONDS=21600
UPLOAD_CHUNK_SIZE=8388608
UPLOAD_SESSION_TTL_HOURS=48
CBZ_MAX_FILE_SIZE=2147483648
CBZ_MAX_ENTRIES=5000
CBZ_MAX_UNCOMPRESSED_SIZE=6442450944
CBZ_MAX_ENTRY_SIZE=209715200
CBZ_MAX_COMPRESSION_RATIO=200
IMAGE_MAX_PIXELS=250000000
VOICE_SAMPLE_MAX_SIZE=26214400

# Gemini (leave unset to disable cloud AI features)
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Files API uploads panel images once so vision calls reference URIs instead of base64 (smaller/fewer requests)
GEMINI_FILES_API=true
# Max images per vision call; a whole chapter fits one call when <= this
GEMINI_MAX_IMAGES_PER_CALL=24
GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts
GEMINI_THINKING_LEVEL=high
GEMINI_TIMEOUT_MS=180000
AI_TILE_HEIGHT=2400
AI_TILE_OVERLAP=300

# Public manga metadata — seeds characters/description/cover on project create
MANGA_METADATA_ENABLED=true
JIKAN_API_BASE=https://api.jikan.moe/v4
METADATA_TIMEOUT_MS=8000

# Optional local TTS service (ai-service/, see docker compose profile "local-ai")
LOCAL_TTS_URL=http://127.0.0.1:8001

# Rendering (Remotion + FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDERER_DIR=video-renderer
RENDER_SEGMENT_SECONDS=30
RENDER_MEDIA_BASE_URL=       # defaults to BASE_URL
RENDER_BROWSER_EXECUTABLE=   # defaults to Remotion's managed headless Chrome
RENDER_CHECKPOINT_DIR=tmp/render-checkpoints

# Background workers (API runs them in-process when true, or `npm run worker`)
WORKERS_IN_PROCESS=true
JOB_CONCURRENCY_EXTRACTION=2
JOB_CONCURRENCY_PDF=1
JOB_CONCURRENCY_IMAGE=2
JOB_CONCURRENCY_AI=2
JOB_CONCURRENCY_TTS=1
JOB_CONCURRENCY_RENDER=1
